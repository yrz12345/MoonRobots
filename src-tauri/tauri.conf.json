{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonRobots",
  "version": "0.1.0",
  "identifier": "io.github.yrz12345.moonrobots",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoonRobots",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "MoonRobots",
    "category": "DeveloperTool",
    "shortDescription": "Explainable robots.txt policy workbench",
    "longDescription": "MoonRobots parses robots.txt policies, explains URL decisions, compares policy revisions and analyzes dynamic rule coverage.",
    "copyright": "Copyright © 2026 yrz12345",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
